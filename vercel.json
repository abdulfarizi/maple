{
  "rewrites": [
    { "source": "/owner", "destination": "/index.html" },
    { "source": "/owner/", "destination": "/owner/index.html" },
    { "source": "/spotify-callback", "destination": "/spotify-callback/index.html" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(icon.svg|icon-192.png|icon-512.png|icon-maskable-512.png|apple-icon.png|favicon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
